# Multi-stage build for Dashboard service
FROM python:3.9-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements
COPY requirements.txt requirements-dashboard.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-dashboard.txt && \
    pip install --no-cache-dir streamlit plotly dash

# Production stage
FROM python:3.9-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user
RUN groupadd -r dashboard && useradd -r -g dashboard dashboard

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=dashboard:dashboard dashboard_enhanced/ ./dashboard_enhanced/
COPY --chown=dashboard:dashboard src/utils/ ./src/utils/
COPY --chown=dashboard:dashboard deploy/configs/dashboard_config.yaml ./config.yaml

# Create directories for cache and logs
RUN mkdir -p /app/.streamlit /app/logs /app/cache && \
    chown -R dashboard:dashboard /app

# Copy Streamlit configuration
COPY --chown=dashboard:dashboard deploy/configs/streamlit_config.toml /app/.streamlit/config.toml

# Switch to non-root user
USER dashboard

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/healthz || exit 1

# Expose port
EXPOSE 8501

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Run Streamlit app
CMD ["streamlit", "run", "dashboard_enhanced/app.py", "--server.maxUploadSize=200"]